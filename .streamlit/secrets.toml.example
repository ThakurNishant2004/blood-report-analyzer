# Local: copy this file to .streamlit/secrets.toml and fill in your key.
# Streamlit Cloud: paste the same line in App settings -> Secrets.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY = "your-groq-api-key"

# Optional: override the model cascade if Groq retires a model (comma separated).
# See https://console.groq.com/docs/models
# GROQ_MODELS = "openai/gpt-oss-120b, openai/gpt-oss-20b"
